{
  "name": "eval-vault",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @eval-vault/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @eval-vault/web build",
    "typecheck": "pnpm --filter @eval-vault/web typecheck",
    "lint": "pnpm --filter @eval-vault/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @eval-vault/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.34",
      "@hono/node-server": "1.19.15",
      "ajv@<7": "6.14.0",
      "ajv@>=7 <8.18.0": "8.18.0",
      "minimatch": "10.2.3",
      "picomatch": "4.0.4",
      "brace-expansion@<2": "1.1.17",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=5 <6": "5.0.9",
      "flatted": "3.4.2",
      "express-rate-limit": "8.2.2",
      "path-to-regexp": "8.4.0",
      "lodash": "4.17.21",
      "postcss": "8.5.23",
      "ip-address": "10.3.1",
      "qs": "6.15.2",
      "@babel/core": "7.29.6",
      "body-parser": "2.3.0",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "shell-quote": "1.9.0",
      "sharp": "0.35.0"
    }
  }
}
