# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region
# Optional: public base URL for objects in a public bucket
B2_PUBLIC_URL_BASE=

# Anthropic (Claude) — required only when running an eval. The bucket
# explorer and /health work without it.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Frontend → API base URL (used by apps/web). Defaults to localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001AbCdEfGhIjKlMnOpQrStUvWxYz0=
# B2_BUCKET_NAME=my-eval-vault
# B2_REGION=us-west-004
# ANTHROPIC_API_KEY=sk-ant-...
